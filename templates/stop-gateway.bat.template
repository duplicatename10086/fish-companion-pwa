@echo off
rem Stop AstrBot (the process that owns the configured port).
rem Generated by scripts/render.py. Do NOT edit by hand.
setlocal enabledelayedexpansion
set "PORT={{ports.astrbot}}"
set "FOUND="
for /f "tokens=5" %%p in ('netstat -ano -p tcp ^| findstr /C:":%PORT% " ^| findstr /C:"LISTENING"') do (
    echo Stopping AstrBot ^(PID %%p^) ...
    taskkill /PID %%p /F /T >nul 2>&1
    set "FOUND=1"
)
ping -n 3 127.0.0.1 >nul
netstat -ano -p tcp | findstr /C:":%PORT% " | findstr /C:"LISTENING" >nul 2>&1
if not errorlevel 1 (
    echo [FAIL] port %PORT% is still busy.
    echo        It may have been started elevated - run as administrator once, or reboot.
) else if defined FOUND (
    echo Done - AstrBot stopped.
) else (
    echo AstrBot is not running.
)
ping -n 4 127.0.0.1 >nul
