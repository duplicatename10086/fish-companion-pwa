@echo off
chcp 65001 >nul
rem ============================================================
rem  Manual launcher - AstrBot gateway + (optionally) local model.
rem  Generated by scripts/render.py from config.json. Do NOT edit by hand.
rem
rem  Order matters: if model.mode=local, the PWA always talks to the local
rem  model first, so we start it and wait before starting AstrBot.
rem
rem  Optional first argument: quiet  (do NOT open the chat page).
rem ============================================================
set "HERE=%~dp0"
set "PY={{astrbot.venv_python}}"
set "EXE={{astrbot.venv_astrbot}}"
set "DATADIR={{astrbot.data_dir}}"
set "LOGFILE=%HERE%logs\astrbot-console.log"
set "APORT={{ports.astrbot}}"
set "MPORT={{ports.local_model}}"
set "MODE={{model.mode}}"
set "WAIT={{model.local.wait_seconds}}"

netstat -ano -p tcp | findstr /C:":%APORT% " | findstr /C:"LISTENING" >nul 2>&1
if not errorlevel 1 (
    echo AstrBot is already running - opening the chat page.
    if /I not "%~1"=="quiet" start "" "http://127.0.0.1:%APORT%/chat"
    exit /b 0
)

if /I not "%MODE%"=="local" goto model_done

netstat -ano -p tcp | findstr /C:":%MPORT% " | findstr /C:"LISTENING" >nul 2>&1
if not errorlevel 1 goto model_ready
echo Starting local model (%MPORT%) ...
start "" /b cmd.exe /c ""%HERE%start-model.bat""

set /a WAITED=0
:model_wait
netstat -ano -p tcp | findstr /C:":%MPORT% " | findstr /C:"LISTENING" >nul 2>&1
if not errorlevel 1 goto model_ready
set /a WAITED+=2
if %WAITED% GEQ %WAIT% (
    echo [WARN] local model not listening after %WAIT%s - starting AstrBot anyway.
    goto model_ready
)
ping -n 3 127.0.0.1 >nul
goto model_wait
:model_ready

:model_done
echo Starting AstrBot ...
echo   data : %DATADIR%
echo   log  : %LOGFILE%
echo.

if /I "%~1"=="quiet" goto skip_open
start "" wscript.exe //nologo "%HERE%launch-hidden.vbs" "http://127.0.0.1:%APORT%/chat"
:skip_open

cd /d "%DATADIR%"
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
"%PY%" -X utf8 "%EXE%" run >> "%LOGFILE%" 2>&1

echo.
echo AstrBot exited with code %ERRORLEVEL%.
ping -n 9 127.0.0.1 >nul
