@echo off
rem Stop the local model (whatever is listening on the configured port).
rem Generated by scripts/render.py. Do NOT edit by hand.
setlocal enabledelayedexpansion
set "PORT={{model.local.port}}"
set "FOUND="
for /f "tokens=5" %%p in ('netstat -ano -p tcp ^| findstr /C:":%PORT% " ^| findstr /C:"LISTENING"') do (
    echo Stopping llama-server ^(PID %%p^) ...
    taskkill /PID %%p /F /T >nul 2>&1
    set "FOUND=1"
)
if not defined FOUND (
    echo Local model is not running.
) else (
    echo Stopped.
)
ping -n 3 127.0.0.1 >nul
