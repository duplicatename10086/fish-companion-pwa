@echo off
rem ============================================================
rem  Local model (llama.cpp, OpenAI-compatible server).
rem  Generated by scripts/render.py from config.json. Do NOT edit by hand:
rem  change config.json then run: python scripts/render.py
rem
rem  Values below are filled from your config:
rem    gguf    = {{model.local.gguf}}
rem    port    = {{model.local.port}}
rem    modelid = {{model.local.model_id}}
rem ============================================================
set "BIN={{model.local.llama_server}}"
set "MODEL={{model.local.gguf}}"
set "LOG={{model.local.log}}"
set "PORT={{model.local.port}}"
set "HOST={{model.local.host}}"
set "CTX={{model.local.context}}"
set "NGL={{model.local.ngl}}"
set "ALIASES={{model.local.aliases}}"
set "EXTRA={{model.local.extra_flags}}"

if not exist "%BIN%" (
    echo [ERROR] missing llama-server: %BIN%
    echo Please set model.local.llama_server in config.json
    exit /b 1
)
if not exist "%MODEL%" (
    echo [ERROR] missing model: %MODEL%
    echo Please set model.local.gguf in config.json
    exit /b 1
)

netstat -ano -p tcp | findstr /C:":%PORT% " | findstr /C:"LISTENING" >nul 2>&1
if not errorlevel 1 (
    echo Local model already listening on %PORT%.
    exit /b 0
)

for %%D in ("%LOG%\..") do if not exist %%~fD mkdir %%~fD

echo Starting llama-server ...
echo   model : %MODEL%
echo   log   : %LOG%
"%BIN%" -m "%MODEL%" --host %HOST% --port %PORT% -ngl %NGL% -c %CTX% -a "%ALIASES%" %EXTRA% >> "%LOG%" 2>&1
