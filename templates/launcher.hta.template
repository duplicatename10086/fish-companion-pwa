<!doctype html>
<html>
<!--
  {{branding.app_name}} launcher.
  Generated by scripts/render.py from config.json. Do NOT edit by hand:
  change config.json then run: python scripts/render.py

  Status probes use HTTP only (WinHttp), so no console windows flash.
-->
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{branding.app_name}} 启动器</title>
<hta:application
  id="app" applicationname="companion-launcher"
  border="thin" caption="yes" maximizebutton="no" minimizebutton="yes"
  scroll="no" selection="no" innerborder="no" showintaskbar="yes" singleinstance="no"
/>
<style>
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; overflow: hidden; }
  body {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    background: #131a33;
    background: radial-gradient(120% 90% at 50% 0%, #22305c 0%, #131a33 55%, #0c1122 100%);
    color: #e7ecff; text-align: center; user-select: none;
  }
  .card { width: 420px; margin: 0 auto; padding: 22px 26px 18px; }
  .fish { font-size: 36px; line-height: 1; }
  h1 { font-size: 19px; margin: 10px 0 3px; font-weight: 600; letter-spacing: .5px; }
  .sub { font-size: 12px; color: #8ea0cc; margin-bottom: 16px; }
  .status { margin-bottom: 14px; font-size: 14px; }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 5px; background: #55617f; margin-right: 8px; vertical-align: 1px; }
  .dot.on { background: #52d98a; box-shadow: 0 0 0 4px rgba(82,217,138,.18), 0 0 12px rgba(82,217,138,.55); }
  .dot.busy { background: #f0b13c; box-shadow: 0 0 0 4px rgba(240,177,60,.2); }
  .rows { border-top: 1px solid #2b3a63; border-bottom: 1px solid #2b3a63; padding: 6px 2px; margin-bottom: 14px; }
  .row { padding: 5px 4px; font-size: 13px; color: #b9c6e8; overflow: hidden; }
  .row span { float: left; } .row b { float: right; font-weight: 600; color: #e7ecff; }
  .row b.off { color: #7d88a6; font-weight: 400; } .row b.on { color: #52d98a; }
  .btns { overflow: hidden; }
  button { font-family: inherit; font-size: 13px; font-weight: 600; color: #fff; border: 0; border-radius: 8px; cursor: pointer; padding: 9px 0; background: #3b74ff; background: linear-gradient(180deg, #3b74ff, #2c58d8); box-shadow: 0 4px 10px rgba(44,88,216,.3); margin-bottom: 8px; }
  button:hover { background: #4a80ff; }
  button:disabled { background: #2a3350; color: #6d7898; cursor: default; box-shadow: none; }
  .half { width: 48%; float: left; } .half.right { float: right; }
  .danger { background: #c94a4a; background: linear-gradient(180deg, #e05a5a, #b93a3a); box-shadow: 0 4px 10px rgba(185,58,58,.28); }
  .danger:hover { background: #d55c5c; } .danger:disabled { background: #2a3350; box-shadow: none; }
  .muted { background: #33405f; background: linear-gradient(180deg, #3d4c70, #33405f); box-shadow: none; }
  .muted:hover { background: #46567d; } .muted:disabled { background: #2a3350; box-shadow: none; }
  button.ghost { display: block; width: 100%; margin-top: 2px; padding: 8px 0; background: transparent; color: #9fb2dd; border: 1px solid #3a4a72; box-shadow: none; font-weight: 500; }
  button.ghost:hover { background: transparent; color: #d7e2ff; border-color: #55709f; }
  .log { margin-top: 10px; height: 32px; font-size: 12px; color: #8291b5; line-height: 1.4; overflow: hidden; }
  .err { color: #ff9b9b; }
</style>
</head>
<body>
<div class="card">
  <div class="fish">{{branding.app_name}}</div>
  <h1>{{branding.app_name}} 启动器</h1>
  <div class="sub">AstrBot {{ports.astrbot}} · 本地模型 {{ports.local_model}} · 只手动启停</div>
  <div class="status"><span id="dot" class="dot"></span><span id="stateText">检查中…</span></div>
  <div class="rows">
    <div class="row"><span>网关 {{ports.astrbot}}</span><b id="sGw" class="off">—</b></div>
    <div class="row"><span>本地模型 {{ports.local_model}}</span><b id="sMd" class="off">—</b></div>
  </div>
  <div class="btns">
    <button id="btnStart" class="half" onclick="doStart()">开启网关</button>
    <button id="btnStop" class="half right danger" onclick="doStop()">关闭网关</button>
    <button id="btnModelStart" class="half muted" onclick="doModelStart()">开启模型</button>
    <button id="btnModelStop" class="half right muted" onclick="doModelStop()">关闭模型</button>
  </div>
  <button class="ghost" onclick="openChat()">打开聊天页</button>
  <div id="log" class="log"></div>
</div>

<script language="JScript">
  var sh = new ActiveXObject("WScript.Shell");
  var APORT = {{ports.astrbot}};
  var MPORT = {{ports.local_model}};
  var selfPath = unescape(location.pathname).replace(/\//g, "\\").replace(/^\\/, "");
  var BASE = selfPath.substring(0, selfPath.lastIndexOf("\\"));
  var busy = false;

  function say(msg, isErr) {
    var el = document.getElementById("log");
    el.innerHTML = msg || "";
    el.className = isErr ? "log err" : "log";
  }
  function httpOk(url, timeoutMs) {
    try {
      var x = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
      x.SetTimeouts(timeoutMs, timeoutMs, timeoutMs, timeoutMs);
      x.Open("GET", url, false); x.Send();
      return x.Status === 200;
    } catch (e) { return false; }
  }
  function isGatewayUp() { return httpOk("http://127.0.0.1:" + APORT + "/api/stat/start-time", 900); }
  function isModelUp() { return httpOk("http://127.0.0.1:" + MPORT + "/v1/models", 700); }
  function setRow(id, text, cls) { var el = document.getElementById(id); el.innerHTML = text; el.className = cls || ""; }
  function setButtons(gw, md) {
    document.getElementById("btnStart").disabled = gw;
    document.getElementById("btnStop").disabled = !gw;
    document.getElementById("btnModelStart").disabled = md;
    document.getElementById("btnModelStop").disabled = !md;
  }
  function refresh() {
    if (busy) return;
    var gw = isGatewayUp(); var md = isModelUp();
    var dot = document.getElementById("dot"); var txt = document.getElementById("stateText");
    if (gw && md) { dot.className = "dot on"; txt.innerHTML = "运行中（本地模型）"; }
    else if (gw) { dot.className = "dot busy"; txt.innerHTML = "网关在跑，但模型没起"; }
    else { dot.className = "dot"; txt.innerHTML = "已停止"; }
    setRow("sGw", gw ? "运行中" : "未启动", gw ? "on" : "off");
    setRow("sMd", md ? "运行中" : "未启动", md ? "on" : "off");
    setButtons(gw, md);
  }
  function pollUp(test, maxSec, onDone) {
    var waited = 0;
    var timer = window.setInterval(function () {
      waited += 2;
      if (test()) { window.clearInterval(timer); onDone(true); return; }
      if (waited >= maxSec) { window.clearInterval(timer); onDone(false); }
    }, 2000);
  }
  function doStart() {
    if (isGatewayUp()) { say("网关已经在跑了。"); return; }
    busy = true;
    document.getElementById("dot").className = "dot busy";
    document.getElementById("stateText").innerHTML = "启动中…";
    say(isModelUp() ? "正在启动 AstrBot（隐藏窗口，约 20 秒）…" : "先把本地模型拉起来，再启动 AstrBot…");
    try {
      sh.Run('wscript.exe //nologo "' + BASE + '\\launch-hidden.vbs" "' + BASE + '\\start-gateway.bat" quiet', 0, false);
    } catch (err) { busy = false; say("启动失败：" + err.message, true); return; }
    pollUp(isGatewayUp, 150, function (ok) { busy = false; say(ok ? "起来了。点「打开聊天页」就能聊。" : "150 秒还没起来，看 logs\\astrbot-console.log", !ok); refresh(); });
  }
  function doStop() {
    if (!isGatewayUp()) { say("网关本来就没在跑。"); return; }
    busy = true;
    document.getElementById("stateText").innerHTML = "关闭中…";
    say("正在关闭网关（本地模型保持运行）…");
    try { sh.Run('wscript.exe //nologo "' + BASE + '\\launch-hidden.vbs" "' + BASE + '\\stop-gateway.bat"', 0, false); }
    catch (err) { say("关闭失败：" + err.message, true); }
    pollUp(function () { return !isGatewayUp(); }, 20, function (ok) { busy = false; say(ok ? "网关已关闭。" : "还没关掉？再点一次。", !ok); refresh(); });
  }
  function doModelStart() {
    if (isModelUp()) { say("本地模型已经在跑了。"); return; }
    busy = true;
    document.getElementById("stateText").innerHTML = "加载模型中…";
    say("正在加载本地模型（可能占数 GB 显存，30～40 秒）…");
    try { sh.Run('wscript.exe //nologo "' + BASE + '\\launch-hidden.vbs" "' + BASE + '\\start-model.bat"', 0, false); }
    catch (err) { busy = false; say("启动失败：" + err.message, true); return; }
    pollUp(isModelUp, 120, function (ok) { busy = false; say(ok ? "本地模型已就绪。" : "120 秒还没起来，看 model.local.log 指定日志", !ok); refresh(); });
  }
  function doModelStop() {
    if (!isModelUp()) { say("本地模型本来就没在跑。"); return; }
    busy = true;
    document.getElementById("stateText").innerHTML = "卸载模型中…";
    say("正在关闭本地模型…");
    try { sh.Run('wscript.exe //nologo "' + BASE + '\\launch-hidden.vbs" "' + BASE + '\\stop-model.bat"', 0, false); }
    catch (err) { say("关闭失败：" + err.message, true); }
    pollUp(function () { return !isModelUp(); }, 15, function (ok) { busy = false; say(ok ? "本地模型已关闭（显存释放）。" : "还没关掉？再点一次。", !ok); refresh(); });
  }
  function openChat() {
    if (!isGatewayUp()) { say("网关还没启动呢，先点「开启网关」。", true); return; }
    sh.Run('cmd.exe /c start "" "http://127.0.0.1:' + APORT + '/chat"', 0, false);
  }
  function fitWindow() {
    try {
      window.resizeTo(460, 620);
      window.moveTo(Math.max(0, (screen.availWidth - 460) / 2), Math.max(0, (screen.availHeight - 620) / 2));
    } catch (e) {}
  }
  refresh(); window.setInterval(refresh, 3000); fitWindow();
  window.setTimeout(fitWindow, 300); window.onload = function () { fitWindow(); };
</script>
</body>
</html>
